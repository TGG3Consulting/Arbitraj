        "+@payable",
        "+@external",
        "+def donate(i: uint256, j: uint256, dx: uint256, use_eth: bool = False, receiver: address = msg.sender) -> uint256:",
        "+    assert msg.sender == Factory(self.factory).admin()",
        "+    _old_mid_fee: uint256 = self.mid_fee",
        "+    _old_out_fee: uint256 = self.out_fee",
        "+    self.mid_fee = DONATE_FEE - 2",
        "+    self.out_fee = DONATE_FEE - 1",
        "+    dy: uint256 = self._exchange(msg.sender, msg.value, i, j, dx, 0, use_eth, receiver, ZERO_ADDRESS, EMPTY_BYTES32)",
        "+    self.mid_fee = _old_mid_fee",
        "+    self.out_fee = _old_out_fee",
        "+    return dy"
